{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://study-english.local/contracts/learning.v1",
  "$comment": "P5-5 (E-35): business result of a Writing assessment (writing.assess / repair.assess). The AI only proposes: per-competency outcomes, a diagnosis and pre-generated hint levels. The application decides support impact, evidence use, focus limits, hypothesis status and whether hints may be shown (disclosure check). No band score.",
  "$defs": {
    "score_0_3": { "type": "integer", "minimum": 0, "maximum": 3 },
    "short_text": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "writing_assessment_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1" },
        "job_id": { "type": "string", "minLength": 1 },
        "context_manifest_id": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "processing": { "type": "string", "enum": ["processed", "missing_data", "technical_error"] },
        "competencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "competency_id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "outcome": { "type": "string", "enum": ["met", "not_met", "inconclusive"] },
              "measurement_quality": { "type": "string", "enum": ["sufficient", "insufficient", "unknown"] },
              "opportunity": { "type": "string", "enum": ["observed", "absent", "unknown"] },
              "evidence_refs": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
              "rationale": { "$ref": "#/$defs/short_text" }
            },
            "required": ["competency_id", "outcome", "measurement_quality", "opportunity", "evidence_refs", "rationale"]
          }
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "priority_issues": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "competency_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "location": { "$ref": "#/$defs/short_text" },
                  "symptom": { "$ref": "#/$defs/short_text" },
                  "hypothesis": { "$ref": "#/$defs/short_text" },
                  "expected_verification": { "$ref": "#/$defs/short_text" },
                  "impact": { "$ref": "#/$defs/score_0_3" },
                  "certainty": { "$ref": "#/$defs/score_0_3" }
                },
                "required": ["competency_id", "location", "symptom", "hypothesis", "expected_verification", "impact", "certainty"]
              }
            },
            "other_issues": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/short_text" } },
            "hints": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "level_1": { "$ref": "#/$defs/short_text" },
                    "level_2": { "$ref": "#/$defs/short_text" },
                    "level_3_explanation": { "$ref": "#/$defs/short_text" },
                    "model_rewrite": { "$ref": "#/$defs/short_text" },
                    "concept_check_question": { "$ref": "#/$defs/short_text" },
                    "concept_check_expected": { "type": "string", "minLength": 1, "maxLength": 200 }
                  },
                  "required": ["level_1", "level_2", "level_3_explanation", "model_rewrite", "concept_check_question", "concept_check_expected"]
                }
              ]
            }
          },
          "required": ["priority_issues", "other_issues", "hints"]
        },
        "limitations": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/short_text" } }
      },
      "required": ["schema_version", "job_id", "context_manifest_id", "synthetic", "processing", "competencies", "diagnosis", "limitations"]
    }
  }
}
