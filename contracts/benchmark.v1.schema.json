{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://study-english.local/contracts/benchmark.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "version",
    "content_origin",
    "usage_rights",
    "sources",
    "skills",
    "rubric_refs",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_origin": {
      "enum": [
        "synthetic_fixture",
        "sourced"
      ]
    },
    "usage_rights": {
      "enum": [
        "verified",
        "unknown"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator",
          "rights_basis",
          "ai_processing_allowed"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "rights_basis": {
            "type": "string",
            "minLength": 1
          },
          "ai_processing_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "reading",
          "listening",
          "writing",
          "speaking_text"
        ]
      }
    },
    "rubric_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "hash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "split",
          "category",
          "skill",
          "expected_outcome",
          "item_ref"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "dev",
              "holdout"
            ]
          },
          "category": {
            "enum": [
              "typical_band",
              "error_diagnosis",
              "valid_exception_anti_template",
              "competing_answer",
              "low_signal_inconclusive"
            ]
          },
          "skill": {
            "enum": [
              "reading",
              "listening",
              "writing",
              "speaking_text"
            ]
          },
          "expected_outcome": {
            "enum": [
              "met",
              "not_met",
              "inconclusive"
            ]
          },
          "item_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "hash"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
