{
  "name": "study-english",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "app": "npm run build && node dist/server/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "npm run lint && npm run docs:guide -- --check && npm run typecheck && npm test && npm run build",
    "spike": "vitest run tests/spikes",
    "inventory": "node scripts/cli-inventory.mjs",
    "relay": "tsx scripts/relay/main.ts",
    "router:sync": "node scripts/sync-ai-router.mjs",
    "docs:guide": "node scripts/user-guide.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "ai": "tsx src/cli/ai.ts",
    "worker": "tsx src/worker/main.ts",
    "backup": "tsx src/cli/backup.ts",
    "export": "tsx src/cli/export.ts",
    "sources": "tsx src/cli/sources.ts",
    "author": "tsx src/cli/author.ts",
    "tts": "tsx src/cli/tts.ts",
    "qc:real": "tsx scripts/qc-real-synthetic.ts",
    "seed:reading": "tsx scripts/seed-reading.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
